# ⚡ AlgoMásQueLuz — Backend Environment Variables Template
# Guarda una copia de este archivo como '.env' en la carpeta 'backend' en tu servidor.

# Puerto en el que corre el servidor localmente o en el VPS (por defecto 8001)
PORT=8001

# URL de MongoDB. 
# Si usas MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster.xxxx.mongodb.net/
# Si usas MongoDB Local en tu VPS: mongodb://127.0.0.1:27017
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=algomasqueluz_db

# Secreto JWT para firmar las cookies de autenticación (Genera uno seguro, ej: openssl rand -hex 32)
JWT_SECRET=super-secret-random-64-hex-string-change-this-in-production

# Credenciales iniciales del Administrador (se crearán automáticamente al iniciar la app si no existen)
ADMIN_EMAIL=admin@algomasqueluz.com
ADMIN_PASSWORD=admin_secure_password_here

# Clave de API de Emergent para OCR de facturas (Gemini 3 Pro)
EMERGENT_LLM_KEY=tu_key_aqui

# Configuración de Resend para el envío automático de notificaciones por Email
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev

# URL del Frontend (Plesk o Dominio de Producción)
# Ejemplo: https://crm.algomasqueluz.com o https://tudominio.com
FRONTEND_URL=https://crm.algomasqueluz.com
